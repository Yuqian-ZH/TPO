{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task2/explanation_output.schema.json",
  "title": "Output of explain()",
  "type": "object",
  "required": ["text", "source", "valid", "attempts"],
  "properties": {
    "text": {"type": "string", "minLength": 1},
    "source": {"enum": ["llm", "template"]},
    "valid": {"type": "boolean"},
    "attempts": {"type": "array", "minItems": 1, "maxItems": 2}
  }
}
