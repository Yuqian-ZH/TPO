{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task2/query.schema.json",
  "title": "Counterfactual query",
  "type": "object",
  "required": ["type"],
  "oneOf": [
    {"properties": {"type": {"const": "FIX_ARC"}, "k": {"enum": [1, 2]}, "i": {"type": "integer", "minimum": 0, "maximum": 8}, "j": {"type": "integer", "minimum": 0, "maximum": 8}},
     "required": ["type", "k", "i", "j"], "additionalProperties": false},
    {"properties": {"type": {"const": "MOVE"}, "i": {"type": "integer", "minimum": 1, "maximum": 8}, "k": {"enum": [1, 2]}},
     "required": ["type", "i", "k"], "additionalProperties": false},
    {"properties": {"type": {"enum": ["SWAP", "FORCE_SAME", "FORCE_SEP"]}, "i": {"type": "integer", "minimum": 1, "maximum": 8}, "j": {"type": "integer", "minimum": 1, "maximum": 8}},
     "required": ["type", "i", "j"], "additionalProperties": false},
    {"properties": {"type": {"enum": ["FORCE_ADJ", "FORBID_ADJ"]}, "i": {"type": "integer", "minimum": 0, "maximum": 8}, "j": {"type": "integer", "minimum": 0, "maximum": 8}},
     "required": ["type", "i", "j"], "additionalProperties": false},
    {"properties": {"type": {"const": "APPLY_MODIFICATIONS"}, "mods": {"type": "array", "minItems": 1, "items": {"$ref": "modification.schema.json"}}},
     "required": ["type", "mods"], "additionalProperties": false}
  ]
}
